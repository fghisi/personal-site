<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <script>
    try {
      const t = localStorage.getItem("tema");
      if (t) document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/code.css">
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <header class="topo">
    <div class="container topo__linha">
      <a class="marca" href="/">
        <span class="marca__cursor" aria-hidden="true">~/</span>{{ site.title | lower | replace(" ", "-") }}
      </a>
      <nav aria-label="Principal">
        <ul class="menu">
          {% for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <button class="tema" type="button" aria-label="Alternar tema claro/escuro">
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="conteudo" class="container">
    {{ content | safe }}
  </main>

  <footer class="rodape">
    <div class="container rodape__linha">
      <p>© {{ anoAtual }} {{ site.author.name }}. Textos sob <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.pt_BR">CC BY-SA 4.0</a>.</p>
      <ul class="social">
        {% for s in site.social %}<li><a href="{{ s.url }}">{{ s.label }}</a></li>{% endfor %}
      </ul>
    </div>
  </footer>
  <script src="/js/main.js" defer></script>
</body>
</html>
