{% if not lista.length %}<p class="meta">{{ t.semPosts }}</p>{% endif %}
<ol class="lista">
  {% for post in lista %}
  <li class="cartao">
    <p class="meta"><time datetime="{{ post.date | dataIso }}">{{ post.date | dataExtensa(lang) }}</time></p>
    <h2 class="cartao__titulo"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% if post.data.description %}<p class="cartao__resumo">{{ post.data.description }}</p>{% endif %}
    {% if post.data.tags and post.data.tags.length %}
    <ul class="tags">
      {% for tag in post.data.tags %}<li><a href="{{ t.tagsUrl }}{{ tag | slugify }}/">#{{ tag }}</a></li>{% endfor %}
    </ul>
    {% endif %}
  </li>
  {% endfor %}
</ol>
