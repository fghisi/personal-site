---
permalink: /js/analytics.js
eleventyExcludeFromCollections: true
---
// Google Analytics 4 com consentimento: nada é carregado nem enviado antes de a
// pessoa aceitar no banner. A escolha fica salva neste navegador e vale para o
// site inteiro (inclusive o amardoar). O ID fica em src/_data/site.js.
//
// Cliques: qualquer elemento com data-ga="nome_do_evento" envia esse evento ao
// ser clicado; atributos data-ga-<campo> viram parâmetros (data-ga-causa="Fome"
// → causa: "Fome"). Para outros casos, use window.medir("evento", { ... }).
//
// Em localhost nada é enviado ao Google: os eventos só aparecem no console.
{% if site.ga4 %}
(() => {
  const ID = "{{ site.ga4 }}";
  const CHAVE = "consentimento-analytics";
  const local = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);
  const en = document.documentElement.lang.startsWith("en");
  const txt = en
    ? { msg: "This site uses Google Analytics cookies to understand, anonymously, how it is used. Do you accept?", sim: "Accept", nao: "Decline", rotulo: "Cookie consent" }
    : { msg: "Este site usa cookies do Google Analytics para entender, de forma anônima, como ele é usado. Você aceita?", sim: "Aceitar", nao: "Recusar", rotulo: "Consentimento de cookies" };

  const ler = () => { try { return localStorage.getItem(CHAVE); } catch (e) { return null; } };
  const gravar = (v) => { try { v ? localStorage.setItem(CHAVE, v) : localStorage.removeItem(CHAVE); } catch (e) {} };

  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  let ativo = false;

  function ativar() {
    if (ativo) return;
    ativo = true;
    if (local) { console.info("[analytics] consentimento aceito; em localhost nada é enviado ao Google."); return; }
    gtag("consent", "default", { analytics_storage: "granted", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied" });
    gtag("js", new Date());
    gtag("config", ID);
    const s = document.createElement("script");
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${ID}`;
    document.head.appendChild(s);
  }

  // Envia um evento (só com consentimento)
  window.medir = (nome, params = {}) => {
    if (!ativo) return;
    if (local) { console.info("[analytics] evento", nome, params); return; }
    gtag("event", nome, params);
  };

  // Cliques marcados com data-ga
  document.addEventListener("click", (ev) => {
    const el = ev.target.closest("[data-ga]");
    if (!el) return;
    const params = {};
    for (const [k, v] of Object.entries(el.dataset)) {
      if (k.startsWith("ga") && k.length > 2) params[k.slice(2).toLowerCase()] = v;
    }
    window.medir(el.dataset.ga, params);
  }, true);

  // Banner
  const estilo = `
    .consentimento{position:fixed;left:16px;right:16px;bottom:16px;z-index:1000;max-width:560px;margin-inline:auto;
      display:flex;gap:12px 16px;align-items:center;flex-wrap:wrap;padding:14px 16px;border-radius:14px;
      background:var(--surface,var(--bg,#fff));color:var(--fg,var(--ink,#1f2328));border:1px solid var(--borda,var(--line,#ddd));
      box-shadow:0 8px 28px rgba(0,0,0,.18);font:400 .9rem/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}
    .consentimento p{margin:0;flex:1 1 260px}
    .consentimento__acoes{display:flex;gap:8px;margin-left:auto}
    .consentimento button{font:inherit;font-weight:600;cursor:pointer;border-radius:999px;padding:7px 16px;border:1.5px solid currentColor;background:transparent;color:inherit}
    .consentimento button.sim{background:var(--destaque,var(--goiaba,#c2410c));border-color:transparent;color:var(--bg,#fff)}
    @media (prefers-reduced-motion:no-preference){.consentimento{animation:consentimento-entra .3s ease-out}}
    @keyframes consentimento-entra{from{opacity:0;transform:translateY(8px)}}`;

  function mostrarBanner() {
    if (document.querySelector(".consentimento")) return;
    if (!document.getElementById("consentimento-estilo")) {
      const st = document.createElement("style");
      st.id = "consentimento-estilo";
      st.textContent = estilo;
      document.head.appendChild(st);
    }
    const b = document.createElement("div");
    b.className = "consentimento";
    b.setAttribute("role", "region");
    b.setAttribute("aria-label", txt.rotulo);
    b.innerHTML = `<p>${txt.msg}</p><div class="consentimento__acoes"><button type="button" class="nao">${txt.nao}</button><button type="button" class="sim">${txt.sim}</button></div>`;
    b.querySelector(".sim").onclick = () => { gravar("aceito"); b.remove(); ativar(); };
    b.querySelector(".nao").onclick = () => {
      const tinha = ativo;
      gravar("recusado"); b.remove();
      // Se já tinha aceitado antes, apaga os cookies do GA e recarrega para parar a medição
      if (tinha) {
        document.cookie.split(";").map((c) => c.split("=")[0].trim()).filter((n) => n.startsWith("_ga"))
          .forEach((n) => { document.cookie = `${n}=; Max-Age=0; path=/; domain=${location.hostname.replace(/^www\./, "")}`; document.cookie = `${n}=; Max-Age=0; path=/`; });
        location.reload();
      }
    };
    document.body.appendChild(b);
  }

  // Links "Cookies" no rodapé reabrem o banner para mudar a escolha
  document.addEventListener("click", (ev) => {
    if (!ev.target.closest("[data-preferencias-cookies]")) return;
    ev.preventDefault();
    mostrarBanner();
  });

  const escolha = ler();
  if (escolha === "aceito") ativar();
  else if (escolha !== "recusado") {
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", mostrarBanner);
    else mostrarBanner();
  }
})();
{% else %}
window.medir = () => {};
{% endif %}
